<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CTDS C01 Room Display — macOS launchd 用户级保活配置 -->
  <key>Label</key>
  <string>com.ctds.room-display</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 使用 /usr/bin/env python3 自动解析本机 python3，兼顾 Apple Silicon 与 Intel Mac -->
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>-B</string>
    <string>-m</string>
    <string>room_display</string>
    <string>run</string>
  </array>

  <!-- 工作区根目录绝对路径（请在目标机上替换为实际解压目录绝对路径，例如 /Users/yourname/StarMap-C01-Mac） -->
  <key>WorkingDirectory</key>
  <string>/path/to/StarMap-C01-Mac</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>development/ctds</string>
    <!-- 显式设置 PATH 优先查找 Homebrew (/opt/homebrew) 与 Intel (/usr/local) 的 Python 3.10+，避免被 launchd 默认 PATH 解析至旧版 3.9 -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 登录系统后自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 进程异常退出时自动重启；正常退出(SIGINT/SIGTERM)不强制重启 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- 运行日志与错误输出重定向至私密 var 目录（请对齐目标机实际路径） -->
  <key>StandardOutPath</key>
  <string>/path/to/StarMap-C01-Mac/var/ctds-c01/launchd_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/StarMap-C01-Mac/var/ctds-c01/launchd_stderr.log</string>

  <!-- 避免短时间反复崩溃时无节制重试 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
