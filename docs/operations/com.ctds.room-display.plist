<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CTDS C01 Room Display — macOS launchd 用户级保活配置 -->
  <key>Label</key>
  <string>com.ctds.room-display</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 请根据实际环境调整 python3 绝对路径，例如 /opt/homebrew/bin/python3 或 /usr/bin/python3 -->
    <string>/opt/homebrew/bin/python3</string>
    <string>-B</string>
    <string>-m</string>
    <string>room_display</string>
    <string>run</string>
  </array>

  <!-- 工作区根目录绝对路径 -->
  <key>WorkingDirectory</key>
  <string>/Users/osszhaoke/Downloads/001-CTDSvFoundation-StarMap</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>development/ctds</string>
  </dict>

  <!-- 登录系统后自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 进程异常退出时自动重启；正常退出(SIGINT/SIGTERM)不强制重启 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- 运行日志与错误输出重定向至私密 var 目录 -->
  <key>StandardOutPath</key>
  <string>/Users/osszhaoke/Downloads/001-CTDSvFoundation-StarMap/var/ctds-c01/launchd_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/osszhaoke/Downloads/001-CTDSvFoundation-StarMap/var/ctds-c01/launchd_stderr.log</string>

  <!-- 避免短时间反复崩溃时无节制重试 -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
