# Eight Sleep 云端凭证（必填，只读采集睡眠评分、床温与睡眠体征）
EIGHT_EMAIL=your_email@example.com
EIGHT_PASSWORD=your_password

# AirGradient 室内环境监测器配置（可选，未设置时默认通过局域网自动发现）
# AIRGRADIENT_HOST=192.168.1.100

# 数据库配置（可选，默认使用内置参数）
POSTGRES_PASSWORD=docker

# 服务监听与端口（可选，默认 0.0.0.0:3000）
WEB_BIND=0.0.0.0
WEB_PORT=3000

# 房间展示名称（可选，默认为 睡眠房）
ROOM_NAME=睡眠房
